# IBM Cloud Configuration
# Copy this file to terraform.tfvars and fill in your values

# IBM Cloud API key for Terraform
# Get from: https://cloud.ibm.com/iam/apikeys
ibmcloud_api_key = "your-ibmcloud-api-key-here"

# IBM Cloud API key for pricing API (can be same as above)
pricing_api_key = "your-pricing-api-key-here"

# IBM Cloud region for Code Engine
# Options: us-south, us-east, eu-gb, eu-de, jp-tok, jp-osa, au-syd, ca-tor, br-sao
region = "us-south"

# Resource group name
resource_group_name = "Default"

# Project Configuration
project_name = "vpc-snapshot-calculator"

# Container Registry
# IMPORTANT: registry_region must match where you pushed your images
# For Frankfurt (eu-de), use "de"
# For US South (us-south), use "us"
# For UK (eu-gb), use "uk"
registry_namespace = "vpc-calculator"
registry_region    = "de"  # Change to match your region: "us", "de", "uk", etc.

# API Configuration
api_image_tag           = "latest"
api_min_instances       = 0
api_max_instances       = 10
api_cpu_limit           = "0.5"
api_memory_limit        = "1G"
api_concurrency         = 100
api_concurrency_target  = 80
cache_ttl               = "86400"
cors_origin             = ""  # Empty for wildcard, or set to your frontend URL

# Frontend Configuration
frontend_image_tag      = "latest"
frontend_min_instances  = 0
frontend_max_instances  = 10
